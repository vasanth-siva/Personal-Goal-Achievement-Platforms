# ==============================================================================
# GoalForge Backend Environment Variables Template
# ==============================================================================

# Server Port
SERVER_PORT=8080

# Database Connection (Supabase PostgreSQL / Managed PostgreSQL / AWS RDS)
DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD

# JWT Token Secret (Must be >= 256 bits for HMAC-SHA256)
JWT_SECRET=YourGeneratedSuperSecure256BitOrHigherSecretKeyForGoalForgeProduction
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://goalforge.io,https://app.goalforge.io,http://localhost:5173

# Demo Data Generation (Set to true only for staging/testing; false for production)
DEMO_DATA_ENABLED=false
