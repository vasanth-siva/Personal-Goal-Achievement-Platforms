# ==============================================================================
# GoalForge Frontend Environment Variables Template
# ==============================================================================

# Backend API Endpoint URL
# - In local development: leave as /api to leverage the Vite reverse proxy (defined in vite.config.js)
# - In production / containerized: point to your hosted backend (e.g. https://api.goalforge.io/api)
VITE_API_URL=/api
VITE_API_BASE_URL=/api

# Application Mode
VITE_APP_NAME="GoalForge"
VITE_APP_ENV=production
